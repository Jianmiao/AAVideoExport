<Project>
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <DefineConstants Condition="'$(Configuration)' == 'DevelopmentAudit'">$(DefineConstants);AAVE_DEVELOPMENT_AUDIT</DefineConstants>
    <DefineConstants Condition="'$(Configuration)' == 'UnifiedTimeline'">$(DefineConstants);AAVE_UNIFIED_TIMELINE</DefineConstants>
    <DefineConstants Condition="'$(Configuration)' == 'TransparentRuntime'">$(DefineConstants);AAVE_TRANSPARENT_RUNTIME</DefineConstants>
    <DefineConstants Condition="'$(Configuration)' == 'TransparentNativeClock'">$(DefineConstants);AAVE_TRANSPARENT_RUNTIME;AAVE_NATIVE_ENGINE_CLOCK</DefineConstants>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)local.props" Condition="Exists('$(MSBuildThisFileDirectory)local.props')" />
</Project>
